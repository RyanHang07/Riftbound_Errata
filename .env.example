# Copy to .env and edit. .env is gitignored; this file is the committed record
# of every setting that exists. Defaults live in rb_errata/config.py.

RB_DATABASE_URL=postgresql://rb_errata:rb_errata@localhost:5433/rb_errata
RB_OLLAMA_URL=http://localhost:11434

# Models. Tag says what we meant; digest says what we got. Leave the
# generation digest empty on first run: doctor fails and prints the digest it
# observed, which you paste here once. A silently re-pushed tag then fails.
#
# The embedder is chosen by profile only (rb_errata/config.py EMBED_PROFILES),
# which carries model, pinned digest, dims and prefixes together. Default
# qwen3 (A30); per command: `make recall EMBED=nomic`. RB_EMBED_MODEL and
# RB_EMBED_DIGEST lines from older copies of this file are ignored.
# RB_EMBED_PROFILE=qwen3
RB_GEN_MODEL=qwen3:4b-instruct-2507-q4_K_M
RB_GEN_DIGEST=

# Keep both models off the GPU. Off for everyday speed; turn on for any number
# that goes into a budget or the writeup (the target machine has no GPU).
RB_CPU_ONLY=false
