# Copy to .env and edit. .env is gitignored; this file is the committed record
# of every setting that exists. Defaults live in rb_errata/config.py.

RB_DATABASE_URL=postgresql://rb_errata:rb_errata@localhost:5433/rb_errata
RB_OLLAMA_URL=http://localhost:11434

# Models. Tag says what we meant; digest says what we got. Leave the digests
# empty on first run: doctor fails and prints the digest it observed, which
# you paste here once. From then on a silently re-pushed tag fails doctor.
RB_EMBED_MODEL=nomic-embed-text
RB_EMBED_DIGEST=
# Embedder profile (rb_errata/config.py EMBED_PROFILES), or per command:
# `make ingest EMBED=qwen3`. A profile other than nomic sets model, digest,
# dims and prefixes itself and ignores the RB_EMBED_* lines above.
# RB_EMBED_PROFILE=nomic
RB_GEN_MODEL=qwen3:4b-instruct-2507-q4_K_M
RB_GEN_DIGEST=

# Keep both models off the GPU. Off for everyday speed; turn on for any number
# that goes into a budget or the writeup (the target machine has no GPU).
RB_CPU_ONLY=false
